<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CanonFlow.Evaluator</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>CanonFlow Foundation</Authors>
    <Description>Deterministic Evaluator Orchestrator</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Manifest.fs" />
    <Compile Include="Budgets.fs" />
    <Compile Include="ComponentRunner.fs" />
    <Compile Include="FsAssayRunner.fs" />
    <Compile Include="OndcRunner.fs" />
    <Compile Include="ConstructiveRunner.fs" />
    <Compile Include="Policy.fs" />
    <Compile Include="Pipeline.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanonFlow.Assurance\CanonFlow.Assurance.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Thoth.Json.Net" />
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <PackageReference Include="ONDCFlow.Core" />
    <PackageReference Include="ONDCFlow.Profile.Retail" />
  </ItemGroup>

</Project>
