<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CanonFlow.Assurance</PackageId>
    <Version>0.1.5-alpha</Version>
    <Authors>CanonFlow Foundation</Authors>
    <Description>Deterministic Semantic Infrastructure Core</Description>
    <RepositoryUrl>https://github.com/CanonFlowFoundation/CanonFlow</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NonEmpty.fs" />
    <Compile Include="Verdict.fs" />
    <Compile Include="Truth.fs" />
    <Compile Include="ClaimPolicy.fs" />
    <Compile Include="Assessment.fs" />
    <Compile Include="Hash.fs" />
    <Compile Include="Digest.fs" />
    <Compile Include="Obligation.fs" />
    <Compile Include="EvaluationContext.fs" />
    <Compile Include="Seal.fs" />
    <Compile Include="Receipt.fs" />
    <Compile Include="ConstructiveEvidence.fs" />
    <Compile Include="Ed25519Verify.fs" />
    <Compile Include="Ed25519Sign.fs" />
    <Compile Include="CanonicalReceiptJson.fs" />
    <Compile Include="ObligationManifest.fs" />
    <Compile Include="Verification.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="FSharp.UMX" />
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <PackageReference Include="Thoth.Json.Net" />
  </ItemGroup>

</Project>
