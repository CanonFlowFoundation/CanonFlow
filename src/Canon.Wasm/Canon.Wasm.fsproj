<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DdlParser.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Canon.Core\Canon.Core.fsproj" />
    <ProjectReference Include="..\Canon.Introspect\Canon.Introspect.fsproj" />
    <ProjectReference Include="..\Canon.Fable\Canon.Fable.fsproj" />
    <ProjectReference Include="..\Canon.Emit\Canon.Emit.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="9.0.300" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
  </ItemGroup>

</Project>
