<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CanonFlow.Reports</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>CanonFlow Foundation</Authors>
    <Description>Deterministic Reporting for Evidence Receipts</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ReportCommon.fs" />
    <Compile Include="VerdictView.fs" />
    <Compile Include="HtmlReport.fs" />
    <Compile Include="MarkdownReports.fs" />
    <Compile Include="SarifReport.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanonFlow.Assurance\CanonFlow.Assurance.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Thoth.Json.Net" />
  </ItemGroup>

</Project>
