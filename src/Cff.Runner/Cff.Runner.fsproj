<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cff</ToolCommandName>
    <PackageId>Cff.Runner</PackageId>
    <Version>0.1.0-alpha</Version>
    <Description>Independent fail-closed CFF evidence runner.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cff.Harness\Cff.Harness.fsproj" />
  </ItemGroup>
</Project>
