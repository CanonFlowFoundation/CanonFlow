{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonflow.dev/schemas/evaluation-manifest-v1.json",
  "title": "CanonFlow Evaluation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "profiles", "evaluationContext"],
  "properties": {
    "$schema": { "type": "string" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "artifacts"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ondcProfileRef": { "type": "string", "minLength": 1 },
        "fsassayRulePack": { "type": "string", "minLength": 1 },
        "sealKeyPath": { "type": "string", "minLength": 1 },
        "sealKeyId": { "type": "string", "minLength": 1 }
      }
    },
    "evaluationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instant", "timeProvenance", "network", "locale"],
      "properties": {
        "instant": { "type": "string", "format": "date-time" },
        "timeProvenance": { "type": "string", "minLength": 1 },
        "network": { "enum": ["Forbidden"] },
        "locale": { "const": "invariant" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFiles", "maxInputBytes", "maxJsonDepth", "componentTimeoutSeconds", "totalTimeoutSeconds"],
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 1 },
        "maxInputBytes": { "type": "integer", "minimum": 1 },
        "maxJsonDepth": { "type": "integer", "minimum": 1 },
        "componentTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "totalTimeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
